<Window x:Class="OpenNetMeter.Views.ThreeTextfieldBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Details" Height="250" Width="400">
    <StackPanel Margin="10">
        <TextBlock Text="Original Name" />
        <TextBox x:Name="TextBox1" Margin="0,5" IsEnabled="False"/>
        
        <TextBlock Text="Prefered Name" />
        <TextBox x:Name="TextBox2" Margin="0,5" IsEnabled="False"/>
        
        <TextBlock Text="Display Name:" />
        <TextBox x:Name="TextBox3" Margin="0,5"/>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="75" Margin="5" Click="Ok_Click"/>
            <Button Content="Cancel" Width="75" Margin="5" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
